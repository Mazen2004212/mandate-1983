# Public, non-secret application environment label.
NEXT_PUBLIC_APP_ENV=development

# Browser-safe Supabase values. Copy the local values printed by
# `pnpm supabase:status`; never place service-role credentials here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-anon-or-publishable-key

# Server-only PostgreSQL connection. Use the local DB_URL from Supabase status
# during development and a managed pooler/direct URL in the deployed backend.
# Never prefix this value with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_DATABASE_URL=postgresql://postgres:replace-with-password@127.0.0.1:54322/postgres
